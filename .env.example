# Optional. Never required for unit tests. Do not commit real tokens.
# HF_TOKEN=

# Project root override (otherwise discovered from pyproject.toml).
# SMARTSCAN_ROOT=.

# Domain database and local MLflow (Stage 4+). Paths are project-relative.
# SMARTSCAN_DB=data/smartscan.db
# SMARTSCAN_ARTIFACT_ROOT=artifacts/store
# MLFLOW_BACKEND_STORE_URI=sqlite:///data/mlflow.db
# MLFLOW_ARTIFACT_ROOT=artifacts/mlflow
# MLFLOW_HOST=127.0.0.1
# MLFLOW_PORT=5000
# MLFLOW_ENABLED=1

# Optional Stage 6–7 paths (project-relative unless absolute).
# Live PPO weights (currently SmartScanScheduler v4 candidate). Official frozen-gate
# evidence remains artifacts/models/scheduler_full + held_out_gate.json.
# SMARTSCAN_MODEL_DIR=artifacts/models/scheduler_v4
# SMARTSCAN_DEMO_DIR=artifacts/demo

